{
  "name": "dsh-gemini-multimodal",
  "version": "0.1.11",
  "description": "DeepSeek Harness plugin: multimodal tools (image/audio/video/document understanding, transcription, image generation) via Gemini API or the local Antigravity CLI.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale",
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/*.mjs",
    "test:ci": "node --import tsx --test tests/*.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "gemini",
    "antigravity",
    "multimodal",
    "vision"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RetiredPhysicist/dsh-plugins.git",
    "directory": "packages/dsh-gemini-multimodal"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
