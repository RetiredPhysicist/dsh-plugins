{
  "name": "dsh-all-search",
  "version": "0.2.16",
  "description": "DeepSeek Harness plugin: AnySearch-backed web search with optional TinyFish and DeepSeek search/fetch, registered into ctx.web.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale",
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/*.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "anysearch",
    "search"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-web": "0.2.1-alpha.4",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RetiredPhysicist/dsh-plugins.git",
    "directory": "packages/dsh-all-search"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
